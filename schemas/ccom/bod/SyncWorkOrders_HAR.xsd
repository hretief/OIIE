<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://tempuri.org/SyncWorkOrders.xsd"
    elementFormDefault="qualified"
    xmlns="http://tempuri.org/XMLSchema.xsd"
    xmlns:mstns="http://tempuri.org/XMLSchema.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:oa="http://www.openapplications.org/oagis/9"
    xmlns:ccom="http://www.mimosa.org/ccom4"
>
    <xs:import schemaLocation="../../oagis/Meta.xsd" namespace="http://www.openapplications.org/oagis/9" />
    <xs:import schemaLocation="../CCOM.xsd" namespace="http://www.mimosa.org/ccom4"/>
    
    <xs:element name="SyncWorkOrders">
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="oa:BusinessObjectDocumentType">
                    <xs:sequence>
                        <xs:element name="DataArea">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element ref="oa:Sync"/>
                                    <xs:element name="WorkOrders" minOccurs="1" maxOccurs="unbounded">
                                        <xs:complexType>
                                            <xs:sequence>
                                                <xs:element name="WorkOrder" type="ccom:WorkOrder">
                                                </xs:element>
                                            </xs:sequence>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>
</xs:schema>
