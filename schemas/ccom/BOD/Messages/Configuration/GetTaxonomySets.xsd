<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:oa="http://www.openapplications.org/oagis/9"
	xmlns="http://www.mimosa.org/ccom4"
	targetNamespace="http://www.mimosa.org/ccom4"
	elementFormDefault="qualified"
	attributeFormDefault="unqualified">

   <xs:import schemaLocation="../../OAGIS/Meta.xsd" namespace="http://www.openapplications.org/oagis/9"/>
   <xs:include schemaLocation="../CCOMQuery.xsd"/>

   <xs:element name="GetTaxonomySets">
      <xs:annotation>
         <xs:documentation xml:lang="en">
            Returns 0 to N taxonomy sets and their taxonomies and their super type-sub type connections (unless excluded by a return criteria expression) via a ShowTaxonomySets response.

            Allows optional criteria-based filtering, otherwise all taxonomy sets and connections will be returned. Criteria in the same TaxonomySetsCriteria noun are combined with a logical AND while criteria across different TaxonomySetsCriteria are combined with a logical OR.

            The ChangedSince date/time restricts the result to include only those taxonomy sets and taxonomies that have been modified after the specified date/time to allow querying for incremental updates.

            The InfoSource* criteria can be provided to restrict the result to include only those taxonomies sets in a particular info source (e.g., reference data library).

            If countOnly = true, then the response only contains the number of taxonomy sets, not the data. No value is interpreted as countOnly = false.
         </xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="oa:BusinessObjectDocumentType">
               <xs:sequence>
                  <xs:element name="DataArea">
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element ref="oa:Get"/>
                           <xs:element name="TaxonomySetsCriteria" minOccurs="0" maxOccurs="unbounded">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="UUID" type="UUIDFilter" minOccurs="0" maxOccurs="1"/>
                                    <xs:element name="ShortName" type="TextFilter" minOccurs="0" maxOccurs="unbounded"/>
                                    <xs:element name="ChangedSince" type="UTCDateTimeFilter" minOccurs="0" maxOccurs="1"/>
                                    <xs:element name="InfoSourceUUID" type="UUIDFilter" minOccurs="0" maxOccurs="1"/>
                                    <xs:element name="InfoSourceShortName" type="TextFilter" minOccurs="0" maxOccurs="unbounded"/>
                                    <xs:element name="InfoSourceTypeUUID" type="UUIDFilter" minOccurs="0" maxOccurs="1"/>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>

</xs:schema>