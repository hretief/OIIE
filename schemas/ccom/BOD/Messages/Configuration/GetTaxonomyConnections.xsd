<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:oa="http://www.openapplications.org/oagis/9"
	xmlns="http://www.mimosa.org/ccom4"
	targetNamespace="http://www.mimosa.org/ccom4"
	elementFormDefault="qualified"
	attributeFormDefault="unqualified">

   <xs:import schemaLocation="../../OAGIS/Meta.xsd" namespace="http://www.openapplications.org/oagis/9"/>
   <xs:include schemaLocation="../CCOMQuery.xsd"/>

   <xs:element name="GetTaxonomyConnections">
      <xs:annotation>
         <xs:documentation xml:lang="en">
            Returns 0 to N taxonomies and their super type-sub type connections via a ShowTaxonomyConnections response.

            The difference between this and GetTaxonomies is that GetTaxonomies only returns header data (e.g. identifiers, names, metadata), and is suitable for querying all taxonomies from a repository; while this BOD could be used in a subsequent interaction with the repository to retrieve all connections for a specified taxonomy.

            Allows optional criteria-based filtering, otherwise all taxonomies and connections will be returned. Criteria in the same TaxonomyConnectionsCriteria noun are combined with a logical AND while criteria across different TaxonomyConnectionsCriteria are combined with a logical OR.

            The CCOMClass filter can contain the name or UUID of a CCOM Class that extends BaseType, e.g., 'AssetType' or 'c61cf419-4187-4c48-a937-08efddeafb05'.

            If countOnly = true, then the response only contains the number of taxonomies, not the data. No value is interpreted as countOnly = false.
         </xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="oa:BusinessObjectDocumentType">
               <xs:sequence>
                  <xs:element name="DataArea">
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element ref="oa:Get"/>
                           <xs:element name="TaxonomyConnectionsCriteria" minOccurs="0" maxOccurs="unbounded">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="TaxonomyUUID" type="UUIDFilter" minOccurs="0" maxOccurs="1"/>
                                    <xs:element name="TaxonomyShortName" type="TextFilter" minOccurs="0" maxOccurs="unbounded"/>
                                    <xs:element name="CCOMClass" type="TextFilter" minOccurs="0" maxOccurs="1"/>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>

</xs:schema>