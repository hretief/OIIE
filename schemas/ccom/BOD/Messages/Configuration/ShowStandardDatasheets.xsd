<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:oa="http://www.openapplications.org/oagis/9"
	xmlns:cct="urn:un:unece:uncefact:documentation:standard:CoreComponentType:2"
	xmlns:isdd="http://www.mimosa.org/ccom4-isdd"
	xmlns="http://www.mimosa.org/ccom4"
	targetNamespace="http://www.mimosa.org/ccom4"
	elementFormDefault="qualified"
	attributeFormDefault="unqualified">

	<xs:import schemaLocation="../../OAGIS/Meta.xsd" namespace="http://www.openapplications.org/oagis/9"/>
	<xs:import namespace="urn:un:unece:uncefact:documentation:standard:CoreComponentType:2" schemaLocation="../../../XSD/CoreComponentType_2p0.xsd"/>
	<xs:import namespace="http://www.mimosa.org/ccom4-isdd" schemaLocation="../../../ISDD/isdd.xsd"/>
	<xs:include schemaLocation="../CCOMElements.xsd"/>

	<xs:element name="ShowStandardDatasheets">
		<xs:annotation>
			<xs:documentation xml:lang="en">
Response returning 0 to N datasheets/ISDDs (instances) or the number of datasheets/ISDDs (instances) resulting from the request.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="oa:BusinessObjectDocumentType">
					<xs:sequence>
						<xs:element name="DataArea">
							<xs:complexType>
								<xs:sequence>
									<xs:element ref="oa:Show"/>
									<xs:element name="StandardDatasheets" minOccurs="0" maxOccurs="unbounded">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="Count" type="cct:NumericType" minOccurs="0" maxOccurs="unbounded"/>
												<xs:element name="Datasheet" minOccurs="0" maxOccurs="unbounded">
													<xs:complexType>
														<xs:choice minOccurs="1" maxOccurs="1">
															<xs:element name="ISDDPropertySet" type="PropertySet" minOccurs="1" maxOccurs="1"/>
															<xs:element name="ISSDInstance" type="isdd:ISDDInstance" minOccurs="1" maxOccurs="1"/>
														</xs:choice>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>

</xs:schema>
