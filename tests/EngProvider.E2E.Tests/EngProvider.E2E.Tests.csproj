<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
  </ItemGroup>

  <!-- No ProjectReference to EngProvider: this suite drives the provider over
       HTTP as a separate process, exactly as a real client would. Referencing it
       would let a test bind to internal types and stop proving the wire contract.
       The bootstrap SQL is linked because the fixture seeds the database. -->
  <ItemGroup>
    <None Include="..\..\docs\DDL\ENG_BOOTSTRAP.SQL" Link="ENG_BOOTSTRAP.SQL" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
