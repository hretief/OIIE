bin/
obj/
.vs/
*.user

# Per-developer settings: database name, storage prefix, alias. Copy the template
# rather than committing one developer's values as everyone's default.
#
# Matched by name rather than by path: the API host was split out of SimHost and
# arrived with the same file, which a path-specific rule silently failed to cover.
**/appsettings.Development.json

# Build output from deploy/deploy.ps1
artifacts/

# Test result files produced by dotnet test --results-directory
TestResults/

# Console output from a locally launched SimHost. Written beside the solution
# when the host is started detached for manual testing.
simhost.log
simhost.err.log

# Raw agent session transcripts. These are verbatim terminal output, so they
# capture whatever was on screen -- including secrets that were being redacted
# at the time. One already tripped GitHub push protection: the log of the
# session that removed a Service Bus key quoted that key as a literal while
# verifying the removal.
#
# Keep them locally if useful, but they are not documentation and the review
# cost of scrubbing each one outweighs their value in the repository.
*chatLog.md


# Official MIMOSA use case and scenario PDFs. Source of truth for the scenario
# implementations, but large binaries that never diff usefully - keep them
# locally under docs/ rather than in the history.
docs/*.pdf
