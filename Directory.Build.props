<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Assembly and namespace names are OpenOM.*; the folder layout is flat, matching
    the convention the three source repositories already used. Grouping is done
    with solution folders and .slnf filters rather than a src/ level.
  -->
</Project>
