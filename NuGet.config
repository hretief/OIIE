<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    <clear /> drops machine- and user-level sources for this repository only.
    The Bentley Azure Artifacts feed is configured machine-wide and returns 401
    without the Azure Artifacts credential provider; `dotnet build` degrades to
    an NU1900 warning, but `dotnet add package` and `dotnet restore` fail hard.

    This project has no internal package dependencies, so nuget.org alone is
    correct. If an internal package is ever needed, remove <clear /> and install
    the credential provider instead:
      https://github.com/microsoft/artifacts-credprovider
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
