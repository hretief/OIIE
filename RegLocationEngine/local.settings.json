{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",

    "RegLocationEngine__Enabled": "false",
    "RegLocationEngine__RegLocationBaseUrl": "http://localhost:7073/api",
    "RegLocationEngine__RegLocationApiKey": "",
    "RegLocationEngine__Enterprise": "acme",
    "RegLocationEngine__Domain": "operations",
    "RegLocationEngine__Topics__0": "oiie:sc01/ccom:SyncSegments",
    "RegLocationEngine__SourceId": "REG-LOCATION",
    "RegLocationEngine__LogicalId": "REG-LOCATION",

    "//": "Both legs derive their channel from ITwinFederationId; leaving it empty disables them. This is an iTwin federation id, not an iModel id -- an iModel id here yields a channel nobody publishes to, which fails as silence rather than an error.",
    "RegLocationEngine__ITwinFederationId": "00000000-0000-0000-0000-000000000000",

    "//inbound": "The leg that receives proposals from ENG. InboundDomain is engineering -- ENG's channel -- and must not be the operations domain above, which is this engine's own outbound channel.",
    "RegLocationEngine__IngestEnabled": "true",
    "RegLocationEngine__InboundDomain": "engineering",
    "RegLocationEngine__InboundTopics__0": "oiie:sc01/ccom:SyncSegments",
    "RegLocationEngine__InboundItemId": "1",
    "RegLocationEngine__InboundScopeId": "1",
    "RegLocationEngine__InboundRevision": "0",
    "RegLocationEngine__InboundFallbackClassId": "1001",
    "RegLocationEngine__InboundClassMap__Functional:FunctionalComponentElement": "1001",
    "RegLocationEngine__MaxMessagesPerPoll": "25",

    "//sites": "The bootstrap leg. Its channel is enterprise-level and not derived from ITwinFederationId, because SyncSites is the message that brings an iTwin context into being.",
    "RegLocationEngine__SitesIngestEnabled": "false",
    "RegLocationEngine__SitesTopics__0": "oiie/ccom:SyncSites",
    "RegLocationEngine__SiteNamespaceId": "1",
    "RegLocationEngine__SiteUnitId": "1",
    "RegLocationEngine__SiteTrnId": "1",
    "RegLocationEngine__SiteItemType": "Site",

    "Isbm__BaseUrl": "https://acme-api-isbm-dev.azurewebsites.net/api",
    "Isbm__ApiKey": "",

    "RegLocationEngineSweepSchedule": "0 */5 * * * *",
    "RegLocationEngineIngestSchedule": "*/10 * * * * *",
    "RegLocationEngineSitesIngestSchedule": "*/15 * * * * *"
  }
}
