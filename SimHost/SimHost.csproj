<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Azure.Identity" Version="1.14.2" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- Pinned to 2.x — 3.x is not compatible with the provider deployments. -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oiie.Ccom\Oiie.Ccom.csproj" />
    <ProjectReference Include="..\Oiie.Isbm.Client\Oiie.Isbm.Client.csproj" />
  </ItemGroup>

  <!--
    Personality packs are deployed content, not compiled code. PersonalityPacks/
    holds personality.yaml and Fixtures/classes.yaml under lowercase participant
    ids, because the loader resolves them as Path.Combine(root, ParticipantId).
    The compiled handlers live in Personalities/ under PascalCase type names.
  -->
  <ItemGroup>
    <Content Include="PersonalityPacks\**\*.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Scenario files are deployed content for the same reason: ScenarioCatalog reads
    them from ContentRootPath/Scenarios unless Sandbox:ScenariosPath overrides it.
  -->
  <ItemGroup>
    <Content Include="Scenarios\**\*.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
