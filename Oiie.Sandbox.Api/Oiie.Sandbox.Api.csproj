<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Oiie.Sandbox.Core\Oiie.Sandbox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to 2.x — 3.x is not compatible with the provider deployments. -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
  </ItemGroup>

  <!--
    Personality packs and scenario definitions live beside the engine in
    Oiie.Sandbox.Core, but the loaders resolve them from this host's ContentRootPath,
    so they are linked in rather than duplicated on disk. PersonalityPacks/ holds
    personality.yaml and Fixtures/classes.yaml under lowercase participant ids,
    because the loader resolves them as Path.Combine(root, ParticipantId).
  -->
  <ItemGroup>
    <Content Include="..\Oiie.Sandbox.Core\PersonalityPacks\**\*.yaml"
             Link="PersonalityPacks\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!--
      Channel topology. Deployed as content rather than embedded precisely so it
      can be edited on the App Service: adding a participant or a scenario is a
      file change and a provisioning run, never a rebuild of the solution.
    -->
    <Content Include="..\Oiie.Sandbox.Core\Topology\**\*.yaml"
             Link="Topology\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
