<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RegLocationProvider</RootNamespace>
    <_FunctionsSkipCleanOutput>true</_FunctionsSkipCleanOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required by the ASP.NET Core HTTP integration (IActionResult, HttpRequest). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    No ProjectReference, for the same reason as EngProvider. This app emulates a
    customer functional location registry: it must not see Oiie.Sandbox.Core,
    Oiie.Ccom or any CCOM type. A registry does not know it is being integrated
    with, and the moment it can name a Segment or a BOD the emulation has stopped
    being one.

    In particular it must not reference Oiie.Sandbox.Core's RegLocation
    personality. That code is the integration-side stewardship model; this
    project is the system being integrated with, and the two must not share
    types.
  -->

  <ItemGroup>
    <!--
      Versions match EngProvider deliberately. The Worker and Sdk majors must
      both be 2.x: FunctionsApplication.CreateBuilder does not exist in 1.x,
      and mixing the two produces a CS0234 on Worker.Builder.
    -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" OutputItemType="Analyzer" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.0.2" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.0.0" />

    <!--
      PINNED to the 2.x line. Microsoft.ApplicationInsights 3.x removed
      Microsoft.ApplicationInsights.Extensibility.ITelemetryInitializer, which
      Worker.ApplicationInsights still binds to, so a 3.x resolution kills the
      worker at startup with a TypeLoadException before any function runs.
      Do not let a blanket package upgrade move these.
    -->
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.23.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="Azure.Identity" Version="1.14.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      The provider owns its SQL, following CmsProvider. docs/DDL is reference
      material: it describes REG-LOCATION in the abstract, and is free to carry
      commentary, one-shot DDL or dialect that no running app should depend on.
      What ships here is the shape this app actually creates, so it lives here.

      Both scripts are re-runnable, which is what makes applying them on every
      cold start safe. LogicalName is pinned because SchemaInitializer resolves
      these by name.
    -->
    <EmbeddedResource Include="Infrastructure\Sql\schema.sql"
                      LogicalName="RegLocationProvider.Infrastructure.Sql.schema.sql" />
    <EmbeddedResource Include="Infrastructure\Sql\bootstrap.sql"
                      LogicalName="RegLocationProvider.Infrastructure.Sql.bootstrap.sql" />
  </ItemGroup>
</Project>

