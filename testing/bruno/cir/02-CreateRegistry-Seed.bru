tests {
  test("returns 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Two entries share ciridA — that is the equivalence assertion the whole spec
  exists to express. The third carries ciridB and a property, so the nested
  graph reshaping and the Property child table both get exercised.
}
