tests {
  test("returns 501 until implemented", function () {
    expect(res.getStatus()).to.equal(501);
  });

  test("names the spec clause", function () {
    expect(res.getBody().detail).to.contain("3.1.2");
  });
}

docs {
  CIRID merge rules to assert once this lands:
  - existing entry has a CIRID  -> the new entry adopts it
  - only the supplied entry has -> it propagates to the existing entry
  - neither has one             -> the server mints one and assigns it to both
}
