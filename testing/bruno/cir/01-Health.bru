meta {
  name: 01 Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("SQL is reachable", function () {
    expect(res.getBody().sql).to.equal(true);
    expect(res.getBody().status).to.equal("healthy");
  });

  test("identifies the spec and binding", function () {
    expect(res.getBody().spec).to.equal("ws-CIR 1.0");
    expect(res.getBody().binding).to.equal("REST");
  });
}

docs {
  Anonymous. Also the cold-start canary: SchemaInitializer runs on host start,
  so a healthy response means db_ddladmin worked and the four tables exist.
  Allow 30-60s on the first call while the serverless database resumes.
}
