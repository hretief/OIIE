headers {
  x-sandbox-admin-key: PMpYbgoNqXFkApDrM5xRR5oZTEnGVszB
}

vars:pre-request {
  baseUrl: acme-api-eng-dev.azurewebsites.net
  twinA: c86c9c10-4487-48f6-8f5b-89701307725c
  twinB: 22222222-2222-4222-8222-222222222222
}

docs {
  # OIIE Sandbox
  
  Admin routes require `x-sandbox-admin-key`, set once here for the whole
  collection.
  
  ## iTwins
  
  ENG scopes its design data by iTwin, so a tag number is only unique within one
  plant. `twinA` and `twinB` are two fixed twins used by the isolation requests
  (20-25): they exist so the same TIC-500 can be created in both and shown to be
  two different instruments rather than one overwriting the other.
  
  Requests that name no twin fall into ENG's default twin, which is why 06-10
  still work unchanged.
}
