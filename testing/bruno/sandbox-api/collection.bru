headers {
  x-sandbox-admin-key: {{adminKey}}
}

docs {
  Generated by tools/generate-bruno.ps1. Do not hand-edit: rerun the generator.

  Admin routes authenticate with x-sandbox-admin-key, set once here for the
  whole collection. Read the value from the sandbox site's app settings:

    az webapp config appsettings list -g HilmarRetiefRG -n acme-api-sandbox-dev --query "[?name=='Sandbox__AdminKey'].value | [0]" -o tsv
}
